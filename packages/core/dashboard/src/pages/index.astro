---
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Flare · Dashboard</title>
  </head>
  <body>
    <div id="flare-dashboard">
      <div class="p-6 text-sm text-muted-foreground" role="status">
        Loading Flare…
      </div>
    </div>
    <script>
      import { createElement } from "react";
      import { createRoot } from "react-dom/client";
      import Dashboard from "../components/dashboard";

      const element = document.getElementById("flare-dashboard");
      if (!element) throw Error("Dashboard mount missing");
      createRoot(element).render(createElement(Dashboard));
    </script>
  </body>
</html>
