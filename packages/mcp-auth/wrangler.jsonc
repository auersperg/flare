{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flare-mcp-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // OAuth URLs contain codes/state; do not retain automatic request logs.
  "observability": { "enabled": false },
  "vars": {
    "AUTH_ISSUER": "",
    "MCP_RESOURCE": "",
    "APP_ORIGIN": "",
    "OWNER_LOGIN": "",
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "services": [{ "binding": "RUNTIME", "service": "flare-runtime" }],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "310018",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
}
