{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flare-codex-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "FLARE_SCOPE": "",
    "AUTH_REVISION": "1",
    "MCP_URL": "",
  },
  "secrets": { "required": ["CODEX_AUTH_JSON"] },
  "containers": [
    {
      "class_name": "CodexSession",
      "scheduling_policy": "durable_object",
      "images": { "codex": { "dockerfile": "./Dockerfile" } },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "SESSION", "class_name": "CodexSession" }],
  },
  "exports": {
    "CodexSession": { "type": "durable-object", "storage": "sqlite" },
  },
}
