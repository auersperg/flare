{
  "name": "flare",
  "version": "0.3.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Flare client, server declarations and development CLI",
  "bin": {
    "flare": "./dist/cli/flare.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/sdk/client.d.ts",
      "import": "./dist/sdk/client.js"
    },
    "./server": {
      "types": "./dist/sdk/server.d.ts",
      "import": "./dist/sdk/server.js"
    },
    "./react": {
      "types": "./dist/sdk/react.d.ts",
      "import": "./dist/sdk/react.js"
    },
    "./protocol": {
      "types": "./dist/sdk/protocol.d.ts",
      "import": "./dist/sdk/protocol.js"
    },
    "./cloudflare": {
      "types": "./dist/sdk/cloudflare.d.ts",
      "import": "./dist/sdk/cloudflare.js"
    }
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "zod": "4.6.5",
    "json-schema-to-typescript": "16.0.0"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/auersperg/flare.git",
    "directory": "packages/flare"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
