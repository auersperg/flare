{
  "name": "flare-workspace",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "workspaces": [
    "packages/flare",
    "packages/core",
    "packages/core/dashboard"
  ],
  "scripts": {
    "build": "bun scripts/build-packages.mjs && bun scripts/build-platform.mjs",
    "check": "bun x --bun tsc --noEmit && bun run --bun --cwd packages/core/dashboard check",
    "test": "bun test ./tests",
    "test:kernel": "bun scripts/build-kernel.mjs && bun scripts/kernel-acceptance.mjs",
    "test:packages": "bun run build && bun scripts/package-acceptance.mjs",
    "test:cloud-kernel": "bun scripts/build-kernel.mjs && bun scripts/kernel-acceptance.mjs --cloud",
    "test:cloud-sdk": "bun scripts/sdk-cloud-acceptance.mjs",
    "build:platform": "bun run build",
    "test:platform:cloud": "bun scripts/platform-acceptance.mjs",
    "test:backup:cloud": "bun scripts/backup-acceptance.mjs",
    "format": "bun x --bun prettier --write .",
    "format:check": "bun x --bun prettier --check .",
    "build:dashboard": "bun run --bun --cwd packages/core/dashboard build",
    "deploy:dashboard": "bun run build && bun x --no-install wrangler deploy --config .private/cloudflare/admin.wrangler.json",
    "test:build": "bun run build && bun scripts/verify-build.mjs",
    "verify": "bun run build && bun run check && bun run test && bun run format:check && bun scripts/verify-build.mjs && bun scripts/package-acceptance.mjs",
    "clean": "bun scripts/clean.mjs",
    "test:deletion:cloud": "bun scripts/project-deletion-acceptance.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "6.0.2",
    "wrangler": "4.149.0",
    "prettier-plugin-astro": "1.1.0",
    "@types/bun": "1.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/sdk": "1.31.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/auersperg/flare.git"
  },
  "description": "Self-hosted Cloudflare-native reactive backend with live data, functions, SDK and an online dashboard",
  "packageManager": "bun@1.4.3",
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ]
  }
}
