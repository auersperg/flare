{
  "version": 1,
  "name": "Flared",
  "slug": "flared",
  "deployment": "operators-own-cloudflare-account",
  "hierarchy": ["installation", "customer", "project", "environment"],
  "environments": ["dev", "prod"],
  "dashboard": {
    "hosting": "cloudflare",
    "local": false,
    "requiredForApplicationTraffic": false
  },
  "development": {
    "backend": "cloud-dev",
    "local": ["frontend", "sdk", "cli"],
    "backendEmulatorRequired": false
  },
  "packages": {
    "sdk": "@flared/sdk",
    "cli": "@flared/cli",
    "platform": "@flared/platform"
  },
  "cli": {
    "binary": "flared",
    "implementedCommands": ["build", "link", "dev", "deploy"],
    "plannedCommands": ["platform init", "db generate"]
  },
  "release": {
    "status": "private-minimum",
    "npmPublished": false,
    "openSourceLicenseSelected": false
  },
  "compatibility": {
    "legacySdk": "@reactive-cloud/sdk@0.1.0",
    "existingCloudResources": "preserved-not-renamed",
    "existingSqlTablePrefix": "_reactive_"
  }
}
