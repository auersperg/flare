{
  "version": 1,
  "name": "Flared",
  "slug": "flared",
  "deployment": "operators-own-cloudflare-account",
  "hierarchy": ["installation", "customer", "project", "environment"],
  "environments": ["dev", "prod"],
  "dashboard": {
    "hosting": "cloudflare",
    "local": false,
    "requiredForApplicationTraffic": false
  },
  "development": {
    "backend": "cloud-dev",
    "local": ["frontend", "sdk", "cli"],
    "backendEmulatorRequired": false
  },
  "packages": {
    "application": "flared",
    "platform": "@flared/platform"
  },
  "cli": {
    "binary": "flared",
    "implementedCommands": ["build", "link", "dev", "deploy"],
    "plannedCommands": ["platform init"]
  },
  "release": {
    "status": "private-minimum",
    "npmPublished": false,
    "openSourceLicenseSelected": false
  },
  "compatibility": {
    "runtimeAbi": 4,
    "legacySdkSupported": false,
    "legacySqlSupported": false,
    "existingCloudResources": "not-modified-by-local-build",
    "systemTablePrefix": "_flared_"
  },
  "distribution": {
    "applicationPackage": "flared",
    "commands": ["dev", "deploy"],
    "registryPublished": false
  }
}
